{
    "name": "sglang",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "containerEnv": {
        "http_proxy": "http://127.0.0.1:8118",
        "https_proxy": "http://127.0.0.1:8118",
        "HTTP_PROXY": "http://127.0.0.1:8118",
        "HTTPS_PROXY": "http://127.0.0.1:8118",
        "NO_PROXY": "localhost,127.0.0.1"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff",
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "anthropic.claude-code"
            ]
        }
    },
    "forwardPorts": [],
    "runArgs": [
        "--gpus", "all",
        "--network=host",
        "--shm-size=32g",
        "--privileged",
        "--ipc=host"
    ],
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/home/devuser/.claude,type=bind",
        "source=/data,target=/root/.cache/huggingface,type=bind"
    ],
    "workspaceMount": "source=${localWorkspaceFolder},target=/sgl-workspace/sglang,type=bind",
    "workspaceFolder": "/sgl-workspace/sglang"
}